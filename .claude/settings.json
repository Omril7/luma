{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run test:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm -w:*)",
      "Bash(npx prisma generate)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright test:*)",
      "Bash(npx tsc --noEmit)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npm run db:*)",
      "Bash(npx prisma migrate:*)",
      "Bash(npx prisma db seed)",
      "Bash(npx prisma studio)",
      "Bash(npx prisma migrate deploy:*)"
    ],
    "deny": ["Read(./.env)", "Read(./**/.env)", "Read(./**/.env.*)"]
  },
  "env": {
    "NODE_ENV": "development"
  }
}
